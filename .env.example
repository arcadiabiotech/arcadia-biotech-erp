APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SMS_PROVIDER: log (default, writes OTP to the log — safe for local/dev
# with no gateway account), msg91, fast2sms, twilio, sns
SMS_PROVIDER=log
SMS_SENDER_ID=ARCADIA

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_ROUTE=4

FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=

TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Company letterhead — printed on the delivery challan header/footer
COMPANY_NAME="Arcadia Biotech"
COMPANY_TAGLINE="Tissue Culture Banana Plants"
COMPANY_ADDRESS="Anand, Gujarat, India"
COMPANY_GST_NUMBER=
COMPANY_MOBILE=9999999999
COMPANY_EMAIL=info@arcadiabiotech.com
COMPANY_WEBSITE=www.arcadiabiotech.com
COMPANY_LOGO_PATH=images/company-logo.png
COMPANY_JURISDICTION=Anand
